<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Super comes through the game, with the test helpers and the build that cooks content. -->
  <ItemGroup>
    <ProjectReference Include="..\Spinner\Spinner.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- The game reads the same cooked content in its tests. -->
  <ItemGroup>
    <SuperContent Include="..\Spinner\content" />
  </ItemGroup>

</Project>
