// How a hut rises out of the ground when it's built. Change it while the game runs, then build another.
// The curve goes from 0 (buried) to 1 (standing), past 1 for a little overshoot before it settles.
{
  "$schema": "../.schemas/motions.schema.json",
  "id": "rise",
  "seconds": 0.8,
  "curve": {
    "keys": [
      { "time": 0, "value": 0 },
      { "time": 0.6, "value": 1.15 },
      { "time": 0.8, "value": 0.95 },
      { "time": 1, "value": 1 },
    ],
  },
}
