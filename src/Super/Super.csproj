<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    <ProjectReference Include="..\Rendition\Rendition.csproj" />
    <ProjectReference Include="..\Super.Random\Super.Random.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
  </ItemGroup>

  <!-- The sample's cube and PNG writer, shared rather than copied. -->
  <ItemGroup>
    <Compile Include="..\Rendition.Sample\Cube.cs" Link="Rendering\Cube.cs" />
    <Compile Include="..\Rendition.Sample\PngFile.cs" Link="Rendering\PngFile.cs" />
  </ItemGroup>

  <!-- Built in, so text works on a fresh checkout and in tests with no files around. -->
  <ItemGroup>
    <EmbeddedResource Include="Ui\Fonts\Inter-Regular.ttf" LogicalName="Inter-Regular.ttf" />
    <EmbeddedResource Include="Ui\Fonts\Inter-Bold.ttf" LogicalName="Inter-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Super.Testing" />
    <InternalsVisibleTo Include="Super.Tests" />
    <InternalsVisibleTo Include="Super.Ecs.Tests" />
  </ItemGroup>

</Project>
