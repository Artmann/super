<Project>

  <!--
    Cooks a game's content as part of its build. Import it in the game's project:

      <Import Project="path\to\Super.targets" />
      <ItemGroup>
        <SuperContent Include="content" />
        <SuperContent Include="..\..\art\content" Only="props/**;textures/**" />
      </ItemGroup>

    Only cooks just the files of that folder its globs match, for a folder several games share.
    With no SuperContent items, the "content" folder beside the project is the root, when there is one.
    The cooked content goes to $(OutDir)content, and content.dev.json beside it tells a game run from
    source where its sources are. Cook errors are build errors, with file and line.
  -->

  <!--
    A published game for one platform ships compiled ahead of time, so it starts without compiling the
    engine's code first. It needs a runtime, as in dotnet publish -r win-x64. Set PublishReadyToRun to
    false in the game's project to turn it off.
  -->
  <PropertyGroup Condition="'$(PublishReadyToRun)' == '' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    A game's code is compiled once, fully optimized, rather than quickly first and again once it runs
    often. The two compilations can round sums differently (the second fuses multiplies and adds), and when
    a method is compiled again depends on the clock, so the same seed and ticks could give a slightly
    different picture each run. Set TieredCompilation to true in the game's project to turn it back on.
  -->
  <PropertyGroup Condition="'$(TieredCompilation)' == ''">
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <PropertyGroup>
    <SuperTarget Condition="'$(SuperTarget)' == ''">desktop</SuperTarget>
    <SuperCookProject>$(MSBuildThisFileDirectory)..\..\tools\Super.Cook.Tool\Super.Cook.Tool.csproj</SuperCookProject>
    <!--
      Properties set on the game's own build, such as by dotnet publish -r win-x64, that would otherwise
      reach the tool. The tool always builds the same way, for the machine doing the build.
    -->
    <_SuperCookRemovedProperties>CurrentSolutionConfigurationContents;BuildingSolutionFile;TargetFramework;TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;_CommandLineDefinedRuntimeIdentifier;_CommandLineDefinedSelfContained;_IsPublishing;PublishDir;PublishProfile;PublishSingleFile;PublishTrimmed;PublishReadyToRun;PublishAot;OutDir;OutputPath;BaseOutputPath;IntermediateOutputPath;BaseIntermediateOutputPath;NoBuild;PlatformTarget</_SuperCookRemovedProperties>
  </PropertyGroup>

  <!--
    The tool is a build-only reference: the game's own restore covers it, and it builds alongside the
    engine rather than after the game. Nothing of it reaches the game: ReferenceOutputAssembly keeps its
    assembly out, Private its files, and PrivateAssets keeps it from a project that references the game,
    such as its tests. OutputItemType hands its path to SuperCook. Every game asks for the same project
    with the same properties, so in a build of many games MSBuild builds the tool once and the others wait
    rather than race. The tool always builds in Release, whatever the game's configuration: running material
    graphs and baking masks takes about half as long as in Debug.

    The reference is left out of MSBuild's project graph (IsGraphBuild). The Release tool references the
    engine too, so with it the graph of a Debug game holds the engine twice, once for each configuration.
    dotnet watch reads that graph and keeps its projects by path and target framework, so it stopped with
    "An item with the same key has already been added" before the game started. The build that dotnet
    watch runs is an ordinary one and still has the reference.
  -->
  <ItemGroup Condition="'$(IsGraphBuild)' != 'true'">
    <ProjectReference Include="$(SuperCookProject)"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      OutputItemType="_SuperCookTool"
                      SetConfiguration="Configuration=Release"
                      GlobalPropertiesToRemove="$(_SuperCookRemovedProperties)" />
  </ItemGroup>

  <!--
    In a solution build, AssignProjectConfiguration replaces SetConfiguration with the solution's own
    mapping, which would build the tool in Debug. This puts Release back. Removing
    CurrentSolutionConfigurationContents above keeps the tool's own references out of the solution's
    mapping too, so the cook libraries build in Release with it.
  -->
  <Target Name="_SuperCookToolInRelease" AfterTargets="AssignProjectConfiguration">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Condition="'%(ProjectReferenceWithConfiguration.OutputItemType)' == '_SuperCookTool'">
        <SetConfiguration>Configuration=Release</SetConfiguration>
        <Configuration>Release</Configuration>
      </ProjectReferenceWithConfiguration>
      <_ProjectReferenceWithConfiguration Condition="'%(_ProjectReferenceWithConfiguration.OutputItemType)' == '_SuperCookTool'">
        <SetConfiguration>Configuration=Release</SetConfiguration>
        <Configuration>Release</Configuration>
      </_ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>

  <!--
    Material graphs (*.material.cs) are C# files in the game's folder, so the game's own build compiles them
    too. That gives them autocomplete and errors in the editor. They need Super.Materials for it, and only
    for that: the cook compiles each graph on its own, and nothing of the library reaches the game's output.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Super.Materials\Super.Materials.csproj"
                      Private="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="SuperCook" AfterTargets="Build">
    <!-- Items are read here rather than when the project loads, so SuperContent can be listed after the import. -->
    <ItemGroup>
      <_SuperRoot Include="@(SuperContent)" />
      <_SuperRoot Include="$(MSBuildProjectDirectory)\content" Condition="'@(SuperContent)' == '' and Exists('$(MSBuildProjectDirectory)\content')" />
      <!-- A trailing slash, as in Include="content\", would escape the closing quote on the Windows command line. -->
      <_SuperRoot>
        <Folder>$([System.String]::Copy('%(FullPath)').TrimEnd('\').TrimEnd('/'))</Folder>
        <!-- Only="props/**;textures/**" becomes one option for each glob. -->
        <OnlyOptions Condition="'%(_SuperRoot.Only)' != ''">--only &quot;$([System.String]::Copy('%(_SuperRoot.Only)').Replace(';', '&quot; --only &quot;'))&quot;</OnlyOptions>
      </_SuperRoot>
    </ItemGroup>

    <!--
      A graph build, as in dotnet build -graph, has no reference to the tool, so the tool is restored and
      built here. ExcludeRestorePackageImports is what restore is normally evaluated with, and keeps that
      evaluation apart from the build's.
    -->
    <MSBuild Projects="$(SuperCookProject)" Targets="Restore" Properties="Configuration=Release;ExcludeRestorePackageImports=true" RemoveProperties="$(_SuperCookRemovedProperties);IsGraphBuild" Condition="'$(IsGraphBuild)' == 'true' and '@(_SuperRoot)' != ''" />
    <MSBuild Projects="$(SuperCookProject)" Targets="Build" Properties="Configuration=Release" RemoveProperties="$(_SuperCookRemovedProperties);IsGraphBuild" Condition="'$(IsGraphBuild)' == 'true' and '@(_SuperRoot)' != ''" />
    <MSBuild Projects="$(SuperCookProject)" Targets="GetTargetPath" Properties="Configuration=Release" RemoveProperties="$(_SuperCookRemovedProperties);IsGraphBuild" Condition="'$(IsGraphBuild)' == 'true' and '@(_SuperRoot)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SuperCookTool" />
    </MSBuild>

    <PropertyGroup>
      <_SuperCookTool>@(_SuperCookTool)</_SuperCookTool>
    </PropertyGroup>
    <Error Condition="'@(_SuperRoot)' != '' and '$(_SuperCookTool)' == ''" Text="super-cook wasn't built, so the content can't be cooked." />

    <!-- Each cook error is a line MSBuild turns into a build error with file and line, so the exit code only matters when there were none. -->
    <Exec Condition="'@(_SuperRoot)' != ''" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardErrorImportance="high"
          Command="dotnet &quot;$(_SuperCookTool)&quot; @(_SuperRoot->'--content &quot;%(Folder)&quot; %(OnlyOptions)', ' ') --out &quot;$(OutDir)content&quot; --target $(SuperTarget) --dev-file &quot;$(OutDir)content.dev.json&quot;">
      <Output TaskParameter="ExitCode" PropertyName="_SuperCookExit" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_SuperCookOutput" />
    </Exec>
    <Error Condition="'@(_SuperRoot)' != '' and '$(_SuperCookExit)' != '0' and !$(_SuperCookOutput.Contains('error SUPER001'))"
           Text="super-cook stopped with exit code $(_SuperCookExit) and no cook error. Its output above says why." />
  </Target>

  <!-- Publishes the cooked content beside the program. content.dev.json is outside it, so it's never published. -->
  <Target Name="SuperPublishContent" AfterTargets="Publish" Condition="Exists('$(OutDir)content')">
    <ItemGroup>
      <_SuperCooked Include="$(OutDir)content\**" />
    </ItemGroup>

    <!-- Objects from an earlier publish that the manifest no longer names would only take up space. -->
    <RemoveDir Directories="$(PublishDir)content" />
    <Copy SourceFiles="@(_SuperCooked)" DestinationFiles="@(_SuperCooked->'$(PublishDir)content\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
