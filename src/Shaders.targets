<Project>

  <!-- Compiles every GLSL shader in Shaders\ to SPIR-V and ships it next to the assembly. -->
  <PropertyGroup>
    <Glslc Condition="'$(VULKAN_SDK)' != ''">$(VULKAN_SDK)\Bin\glslc.exe</Glslc>
    <Glslc Condition="'$(Glslc)' == ''">glslc</Glslc>
    <GlslcFlags>--target-env=vulkan1.3 -O -Werror</GlslcFlags>
    <ShaderOutputDir>$(MSBuildProjectDirectory)\obj\shaders\</ShaderOutputDir>
    <ShaderIncludeDir>$(MSBuildThisFileDirectory)Rendition\Shaders</ShaderIncludeDir>
    <!-- Where this project's shaders come from and how they compile, for live shader reload (ShaderWatch). -->
    <ShaderSourcesFile>$(ShaderOutputDir)$(MSBuildProjectName).sources</ShaderSourcesFile>
  </PropertyGroup>

  <ItemGroup>
    <Shader Include="Shaders\*.vert;Shaders\*.frag;Shaders\*.comp" />
    <ShaderDependency Include="$(ShaderIncludeDir)\*.glsl" />
    <None Include="@(Shader->'$(ShaderOutputDir)%(Filename)%(Extension).spv')"
          Link="shaders\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <!-- Never published: a shipped game has no shader sources to watch. -->
    <None Include="$(ShaderSourcesFile)"
          Link="shaders\$(MSBuildProjectName).sources"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never"
          Visible="false" />
  </ItemGroup>

  <Target Name="WriteShaderSources" BeforeTargets="AssignTargetPaths">
    <MakeDir Directories="$(ShaderOutputDir)" />
    <WriteLinesToFile File="$(ShaderSourcesFile)"
                      Lines="$(Glslc);$(GlslcFlags);$(ShaderIncludeDir);$(MSBuildProjectDirectory)\Shaders"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CompileShaders"
          BeforeTargets="AssignTargetPaths"
          Inputs="@(Shader);@(ShaderDependency)"
          Outputs="@(Shader->'$(ShaderOutputDir)%(Filename)%(Extension).spv')">
    <MakeDir Directories="$(ShaderOutputDir)" />
    <Exec Command="&quot;$(Glslc)&quot; $(GlslcFlags) -I &quot;$(ShaderIncludeDir)&quot; &quot;%(Shader.FullPath)&quot; -o &quot;$(ShaderOutputDir)%(Shader.Filename)%(Shader.Extension).spv&quot;" />
  </Target>

</Project>
