<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Super.Tests" />
    <InternalsVisibleTo Include="Rendition.Gpu.Tests" />
    <InternalsVisibleTo Include="Hamlet.Tests" />
  </ItemGroup>

  <!-- AMD FidelityFX's prebuilt, signed Vulkan library, for FSR upscaling. MIT licensed; see CREDITS.md. -->
  <ItemGroup>
    <None Include="..\..\third_party\fidelityfx\amd_fidelityfx_vk.dll"
          Link="amd_fidelityfx_vk.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!--
    Writes a hash of the lightmap unwrap's source into the assembly, for LightmapUnwrap.Version. The cook keeps
    unwrapped models under it, so they are only unwrapped again when these files change. The assembly's own build
    id would change with any edit to the renderer, and unwrapping the Courtyard takes minutes. Types.cs holds
    Vertex, which the unwrap reads and writes.
  -->
  <Target Name="LightmapUnwrapVersion" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_LightmapUnwrapSource Include="Lightmaps\*.cs;Types.cs" />
    </ItemGroup>
    <GetFileHash Files="@(_LightmapUnwrapSource)">
      <Output TaskParameter="Items" ItemName="_LightmapUnwrapHashed" />
    </GetFileHash>
    <Hash ItemsToHash="@(_LightmapUnwrapHashed->'%(Filename)%(Extension):%(FileHash)')">
      <Output TaskParameter="HashResult" PropertyName="_LightmapUnwrapVersion" />
    </Hash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LightmapUnwrapVersion</_Parameter1>
        <_Parameter2>$(_LightmapUnwrapVersion)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Import Project="..\Shaders.targets" />

</Project>
