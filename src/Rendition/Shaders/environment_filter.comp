#version 460

// Filters one level of the environment from a sharper cube with a full mip chain, by filtered
// importance sampling (Colbert and Krivanek, GPU Gems 3, chapter 20): a few samples, each
// reading the source at the mip whose texels cover about the solid angle that sample stands
// for, so a few dozen samples give what a thousand would from the sharp level. Rough
// reflections take GGX samples with the viewer straight on; the soft light takes
// cosine-weighted ones. See "Environment lighting" in docs/design.md.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform samplerCube source;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2DArray target;

// Must match FilterConstants in Vulkan/EnvironmentMap.cs.
layout(push_constant) uniform Filter {
    int irradiance;     // 1: cosine-weighted over the hemisphere, for the soft light; 0: GGX
    float roughness;
    float texelAngle;   // the solid angle of one texel of the source's sharpest level
    float lodBias;
    uint samples;       // more on the small rough levels, where they cost little and the blur is widest
} filterConstants;

const float PI = 3.14159265359;

vec3 cubeDirection(uint face, vec2 uv) {
    switch (face) {
        case 0: return vec3(1.0, -uv.y, -uv.x);
        case 1: return vec3(-1.0, -uv.y, uv.x);
        case 2: return vec3(uv.x, 1.0, uv.y);
        case 3: return vec3(uv.x, -1.0, -uv.y);
        case 4: return vec3(uv.x, -uv.y, 1.0);
        default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

vec2 hammersley(uint i) {
    return vec2(float(i) / float(filterConstants.samples), float(bitfieldReverse(i)) * 2.3283064365386963e-10);
}

// The mip whose texels cover the solid angle one sample stands for, 1 / (samples * pdf).
float sourceLod(float pdf) {
    float sampleAngle = 1.0 / (float(filterConstants.samples) * max(pdf, 1e-8));
    return max(0.5 * log2(sampleAngle / filterConstants.texelAngle) + filterConstants.lodBias, 0.0);
}

void main() {
    ivec3 size = imageSize(target);
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(texel.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 n = normalize(cubeDirection(uint(texel.z), uv));
    vec3 tangent = normalize(cross(abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
    vec3 bitangent = cross(n, tangent);
    float alpha = filterConstants.roughness * filterConstants.roughness;
    float alpha2 = alpha * alpha;

    vec3 sum = vec3(0.0);
    float totalWeight = 0.0;
    for (uint i = 0; i < filterConstants.samples; i++) {
        vec2 xi = hammersley(i);
        float phi = 2.0 * PI * xi.x;

        if (filterConstants.irradiance == 1) {
            float r = sqrt(xi.y);
            float cosTheta = sqrt(1.0 - xi.y);
            vec3 l = tangent * (r * cos(phi)) + bitangent * (r * sin(phi)) + n * cosTheta;
            sum += textureLod(source, l, sourceLod(cosTheta / PI)).rgb;
            totalWeight += 1.0;
            continue;
        }

        float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (alpha2 - 1.0) * xi.y));
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
        vec3 halfway = tangent * (sinTheta * cos(phi)) + bitangent * (sinTheta * sin(phi)) + n * cosTheta;
        vec3 l = reflect(-n, halfway);
        float weight = dot(n, l);
        if (weight <= 0.0) {
            continue;
        }

        // GGX's D; with the viewer along n the pdf of l is D / 4.
        float d = cosTheta * cosTheta * (alpha2 - 1.0) + 1.0;
        float distribution = alpha2 / (PI * d * d);
        sum += textureLod(source, l, sourceLod(distribution / 4.0)).rgb * weight;
        totalWeight += weight;
    }

    imageStore(target, texel, vec4(sum / max(totalWeight, 1e-8), 1.0));
}
