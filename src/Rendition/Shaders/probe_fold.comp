#version 460
#extension GL_GOOGLE_include_directive : require
#include "sampling.glsl"

// Folds one light probe's six captured faces into its two tiles. The irradiance tile holds,
// for each direction a surface could face, the light reaching it: radiance averaged over the
// half of the sphere in front, weighted by the cosine, as the studio's irradiance map is. The
// depth tile holds the mean and the mean square of the distance seen around each direction,
// which probes.glsl uses to tell whether a point is hidden from the probe. Both are octahedral
// maps with a one-texel border copied from across each edge, so filtering wraps round.
// See "Light probes" in docs/design.md.

layout(local_size_x = 16, local_size_y = 16) in;

// Alpha holds each pixel's distance from the probe, negative where it saw the back of a surface.
layout(set = 0, binding = 0) uniform sampler2DArray faces;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D irradianceAtlas;
layout(rg16f, set = 0, binding = 2) uniform writeonly image2D depthAtlas;

// Must match FoldConstants in Vulkan/ProbeVolume.cs.
layout(push_constant) uniform Fold {
    int probe;
    float maxDistance;
} fold;

// Must match ProbeVolume.cs.
const int FACE_SIZE = 32;
const int COLUMNS = 64;
const int IRRADIANCE_TEXELS = 8;
const int DEPTH_TEXELS = 16;

// Each face is averaged down to this many texels across first, so every texel of a tile
// can look at every sample.
const int REDUCED = 16;
const int SAMPLES = 6 * REDUCED * REDUCED;

// How tightly the depth gathers round its direction. High, so a wall's edge stays sharp.
const float DEPTH_SHARPNESS = 50.0;

shared vec4 samples[SAMPLES];
shared uint backFaces;

// The same faces as reflection_probe.comp.
vec3 cubeDirection(int face, vec2 uv) {
    switch (face) {
        case 0: return vec3(1.0, -uv.y, -uv.x);
        case 1: return vec3(-1.0, -uv.y, uv.x);
        case 2: return vec3(uv.x, 1.0, uv.y);
        case 3: return vec3(uv.x, -1.0, -uv.y);
        case 4: return vec3(uv.x, -uv.y, 1.0);
        default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

// The world direction a reduced sample looks along, and the share of the sphere it covers.
vec3 sampleDirection(int index, out float solidAngle) {
    int face = index / (REDUCED * REDUCED);
    int texel = index % (REDUCED * REDUCED);
    vec2 uv = (vec2(texel % REDUCED, texel / REDUCED) + 0.5) / float(REDUCED) * 2.0 - 1.0;
    vec3 c = cubeDirection(face, uv);
    float lengthSquared = dot(c, c);
    solidAngle = 1.0 / (lengthSquared * sqrt(lengthSquared));
    // A cube map is mirrored compared with the camera that drew it, so z swaps back.
    return vec3(c.x, c.y, -c.z) * inversesqrt(lengthSquared);
}

// The texel inside an n by n tile that a texel of the bordered tile shows. A border texel
// shows its neighbour across the octahedral map's edge, which is mirrored; a corner shows the
// opposite corner.
ivec2 interiorOf(ivec2 b, int n) {
    bool sideX = b.x == 0 || b.x == n + 1;
    bool sideY = b.y == 0 || b.y == n + 1;
    if (sideX && sideY) {
        return ivec2(b.x == 0 ? n - 1 : 0, b.y == 0 ? n - 1 : 0);
    }

    if (sideY) {
        return ivec2(n - b.x, b.y == 0 ? 0 : n - 1);
    }

    if (sideX) {
        return ivec2(b.x == 0 ? 0 : n - 1, n - b.y);
    }

    return b - 1;
}

vec3 texelDirection(ivec2 bordered, int n) {
    vec2 e = (vec2(interiorOf(bordered, n)) + 0.5) / float(n) * 2.0 - 1.0;
    return octahedralDecode(e);
}

void main() {
    int local = int(gl_LocalInvocationIndex);
    if (local == 0) {
        backFaces = 0u;
    }

    barrier();

    uint seenBehind = 0u;
    for (int s = local; s < SAMPLES; s += 256) {
        int face = s / (REDUCED * REDUCED);
        int texel = s % (REDUCED * REDUCED);
        ivec2 corner = ivec2(texel % REDUCED, texel / REDUCED) * 2;
        vec4 sum = vec4(0.0);
        for (int i = 0; i < 4; i++) {
            vec4 seen = texelFetch(faces, ivec3(corner + ivec2(i & 1, i >> 1), face), 0);
            if (seen.a < 0.0) {
                seenBehind++;
            }

            sum += vec4(seen.rgb, min(abs(seen.a), fold.maxDistance));
        }

        samples[s] = sum * 0.25;
    }

    atomicAdd(backFaces, seenBehind);
    barrier();

    ivec2 tile = ivec2(fold.probe % COLUMNS, fold.probe / COLUMNS);

    int irradianceSide = IRRADIANCE_TEXELS + 2;
    if (local < irradianceSide * irradianceSide) {
        ivec2 bordered = ivec2(local % irradianceSide, local / irradianceSide);
        vec3 direction = texelDirection(bordered, IRRADIANCE_TEXELS);
        vec3 sum = vec3(0.0);
        float total = 0.0;
        for (int s = 0; s < SAMPLES; s++) {
            float solidAngle;
            vec3 d = sampleDirection(s, solidAngle);
            float weight = max(dot(direction, d), 0.0) * solidAngle;
            sum += samples[s].rgb * weight;
            total += weight;
        }

        imageStore(irradianceAtlas, tile * irradianceSide + bordered, vec4(sum / max(total, 1e-6), 1.0));
    }

    // Inside a wall or under the floor a probe sees mostly the backs of surfaces, and its light
    // would leak through. Its depth tile's first corner says so, and probes.glsl skips it.
    bool inside = backFaces * 2u > uint(6 * FACE_SIZE * FACE_SIZE);

    int depthSide = DEPTH_TEXELS + 2;
    for (int b = local; b < depthSide * depthSide; b += 256) {
        ivec2 bordered = ivec2(b % depthSide, b / depthSide);
        vec3 direction = texelDirection(bordered, DEPTH_TEXELS);
        vec2 sum = vec2(0.0);
        float total = 0.0;
        for (int s = 0; s < SAMPLES; s++) {
            float solidAngle;
            vec3 d = sampleDirection(s, solidAngle);
            float facing = max(dot(direction, d), 0.0);
            float weight = pow(facing, DEPTH_SHARPNESS) * solidAngle;
            float seen = samples[s].a;
            sum += vec2(seen, seen * seen) * weight;
            total += weight;
        }

        vec2 moments = sum / max(total, 1e-6);
        if (inside && b == 0) {
            moments.y = -1.0;
        }

        imageStore(depthAtlas, tile * depthSide + bordered, vec4(moments, 0.0, 0.0));
    }
}
