#version 460

// Blurs a captured view of the scene into one level of a reflection probe. Each level
// shows how a surface of a given roughness would see the scene, as environment.comp
// does for the studio.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform samplerCube source;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2DArray target;

// Must match FilterConstants in Vulkan/ReflectionProbes.cs.
layout(push_constant) uniform Filter {
    float roughness;
} filterSettings;

const float PI = 3.14159265359;
const uint SAMPLES = 512;

vec3 cubeDirection(uint face, vec2 uv) {
    switch (face) {
        case 0: return vec3(1.0, -uv.y, -uv.x);
        case 1: return vec3(-1.0, -uv.y, uv.x);
        case 2: return vec3(uv.x, 1.0, uv.y);
        case 3: return vec3(uv.x, -1.0, -uv.y);
        case 4: return vec3(uv.x, -uv.y, 1.0);
        default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

vec2 hammersley(uint i) {
    uint bits = bitfieldReverse(i);
    return vec2(float(i) / float(SAMPLES), float(bits) * 2.3283064365386963e-10);
}

void main() {
    ivec3 size = imageSize(target);
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(texel.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 n = normalize(cubeDirection(uint(texel.z), uv));

    if (filterSettings.roughness == 0.0) {
        imageStore(target, texel, vec4(textureLod(source, n, 0.0).rgb, 1.0));
        return;
    }

    vec3 tangent = normalize(cross(abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
    vec3 bitangent = cross(n, tangent);
    float alpha = filterSettings.roughness * filterSettings.roughness;

    vec3 sum = vec3(0.0);
    float totalWeight = 0.0;
    for (uint i = 0; i < SAMPLES; i++) {
        vec2 xi = hammersley(i);
        float phi = 2.0 * PI * xi.x;
        float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
        vec3 h = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
        vec3 direction = reflect(-n, tangent * h.x + bitangent * h.y + n * h.z);
        float weight = max(dot(n, direction), 0.0);
        if (weight > 0.0) {
            sum += textureLod(source, direction, 0.0).rgb * weight;
            totalWeight += weight;
        }
    }

    imageStore(target, texel, vec4(sum / totalWeight, 1.0));
}
