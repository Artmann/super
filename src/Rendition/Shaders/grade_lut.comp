#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "tonemap.glsl"
#include "grade_lut.glsl"

// Bakes the whole grade into the table the tone-mapping pass reads: each cell is the light it
// stands for, put through what tonemap.frag once worked out for every pixel, and then through
// the tones, split toning and the artist's table. Run only when one of them changes.
// See "The grade's table" in docs/design.md.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D grade;

// The artist's table, over sRGB-encoded colour; a 2-cell neutral one when there is none.
layout(set = 1, binding = 1) uniform sampler3D artistLut;

// Contrast turns around this mid grey, so overall brightness holds still.
const float MIDDLE_GREY = 0.18;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

vec3 toSrgb(vec3 linear) {
    linear = clamp(linear, 0.0, 1.0);
    return mix(linear * 12.92, 1.055 * pow(linear, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, linear));
}

vec3 fromSrgb(vec3 encoded) {
    return mix(encoded / 12.92, pow((encoded + 0.055) / 1.055, vec3(2.4)), step(0.04045, encoded));
}

// The tones and split toning, on display colour encoded with a 2.2 gamma so the shadows, mid-tones
// and highlights split where the eye sees them. The tones scale each channel, so black stays black;
// split toning adds a colour with its own brightness taken out, so it moves the hue, not the light.
vec3 tones(vec3 color) {
    vec3 encoded = pow(max(color, vec3(0.0)), vec3(1.0 / 2.2));
    float luma = clamp(dot(encoded, LUMA), 0.0, 1.0);

    float shadows = 1.0 - smoothstep(0.05, 0.45, luma);
    float highlights = smoothstep(0.55, 0.95, luma);
    float midtones = 1.0 - shadows - highlights;
    encoded *= max(vec3(1.0) + frame.toneShadows.rgb * shadows + frame.toneMidtones.rgb * midtones
        + frame.toneHighlights.rgb * highlights, vec3(0.0));

    // The balance moves the turn between shade and light: towards 1, more of the picture is shade.
    float pivot = 0.5 + 0.4 * frame.look.x;
    float shade = 1.0 - smoothstep(0.0, pivot, luma);
    float light = smoothstep(pivot, 1.0, luma);
    vec3 shadeTint = frame.splitShadows.rgb - dot(frame.splitShadows.rgb, LUMA);
    vec3 lightTint = frame.splitHighlights.rgb - dot(frame.splitHighlights.rgb, LUMA);
    encoded += shade * shadeTint + light * lightTint;

    return pow(max(encoded, vec3(0.0)), vec3(2.2));
}

// The artist's table, mixed in by its blend in sRGB, as the table was made. Only what the screen
// can show goes through it; what lies past 0 or 1 is added back after, so a neutral table gives
// back exactly what came in.
vec3 artist(vec3 color, float blend) {
    vec3 shown = clamp(color, 0.0, 1.0);
    vec3 encoded = toSrgb(shown);
    float size = float(textureSize(artistLut, 0).x);
    vec3 graded = texture(artistLut, lutCoordinate(encoded, size)).rgb;
    return fromSrgb(clamp(mix(encoded, graded, blend), 0.0, 1.0)) + (color - shown);
}

vec3 graded(vec3 color) {
    // White balance, channel mixer and hue shift come first, on the light itself, as a camera's would.
    color = max(mat3(frame.colorMatrix) * color, vec3(0.0));
    color = pow(color / MIDDLE_GREY + 1e-5, vec3(frame.grade.y)) * MIDDLE_GREY;
    color = max(mix(vec3(dot(color, LUMA)), color, frame.grade.z), vec3(0.0));

    // curve.x picks the curve: 0 for AgX, 1 for ACES, 2 for PBR Neutral.
    if (frame.curve.x > 1.5) {
        color = pbrNeutral(color);
    } else if (frame.curve.x > 0.5) {
        color = acesFilmic(color);
    } else {
        color = agx(color, frame.curve.yz);
    }

    // Gain scales every channel, so it shows most in the highlights. Lift adds colour that fades
    // out towards white, so the shade takes a tint while white stays white. What the curve gives
    // past white is held there first, as the screen would; under black is kept, for the table to
    // interpolate across, and clamped after it is read.
    color = min(color, vec3(1.0)) * frame.gain.rgb;
    color += frame.lift.rgb * (1.0 - clamp(color, 0.0, 1.0));

    if (frame.look.y > 0.5) {
        color = tones(color);
    }

    if (frame.curve.w > 0.0) {
        color = artist(color, frame.curve.w);
    }

    return color;
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(cell, ivec3(GRADE_LUT_SIZE)))) {
        return;
    }

    vec3 light = gradeLutDecode(vec3(cell) / (GRADE_LUT_SIZE - 1.0));
    imageStore(grade, cell, vec4(graded(light), 1.0));
}
