#version 460
#extension GL_GOOGLE_include_directive : require
#include "sky.glsl"

// Bakes one level of the studio environment. Every texel integrates the studio's
// light as a surface of a given roughness would see it, so the lighting pass only
// has to look up a blurred reflection instead of tracing many rays per pixel.
// With a turbidity set, a clear sky takes the place of the ceiling and horizon.

layout(local_size_x = 8, local_size_y = 8) in;

struct Panel {
    vec4 direction; // xyz: from the studio's centre to the panel
    vec4 right;     // xyz: unit axis; w: half width
    vec4 up;        // xyz: unit axis; w: half height
    vec4 radiance;  // rgb
};

// Must match GpuEnvironment in Vulkan/EnvironmentMap.cs.
layout(std140, set = 0, binding = 0) uniform Environment {
    vec4 ceiling;
    vec4 horizon;
    vec4 floorColor;
    vec4 skySun;  // xyz: towards the sun; w: turbidity, 0 for the bands
    vec4 sunDisc; // rgb: how bright the sun's disc is; a: the cosine of its angular radius
    int panelCount;
    Panel panels[8];
} environment;

layout(rgba16f, set = 0, binding = 1) uniform writeonly image2DArray target;

// Must match BakeConstants in Vulkan/EnvironmentMap.cs.
layout(push_constant) uniform Bake {
    int irradiance; // 1: blur over the whole hemisphere, for diffuse light
    float roughness;
    int sky;        // 1: leave the panels out, as the irradiance does, for light probes
} bake;

const float PI = 3.14159265359;
const uint SAMPLES = 1024;

// Set once in main, so each of a texel's samples doesn't work it out again.
SkyState clearSky;

// A clear sky above the horizon and the floor below it, fading from the sky's own horizon.
vec3 skyAndFloor(vec3 direction) {
    if (direction.y >= 0.0) {
        vec3 color = skyRadiance(clearSky, direction);

        // The direct light already gives surfaces the sun, so only the sharp reflection shows its disc.
        if (bake.irradiance == 0 && bake.sky == 0 && bake.roughness == 0.0) {
            color += sunDiscRadiance(direction, normalize(environment.skySun.xyz), environment.sunDisc);
        }

        return color;
    }

    vec2 across = direction.xz;
    vec3 level = dot(across, across) > 1e-8 ? normalize(vec3(across.x, 0.0, across.y)) : vec3(1.0, 0.0, 0.0);
    return mix(skyRadiance(clearSky, level), environment.floorColor.rgb, sqrt(-direction.y));
}

vec3 studio(vec3 direction) {
    vec3 color;
    if (environment.skySun.w > 0.0) {
        color = skyAndFloor(direction);
    } else {
        color = direction.y >= 0.0
            ? mix(environment.horizon.rgb, environment.ceiling.rgb, sqrt(direction.y))
            : mix(environment.horizon.rgb, environment.floorColor.rgb, sqrt(-direction.y));
    }

    // Direct lights already provide the panels' diffuse light. Only reflections show them.
    int panelCount = bake.irradiance == 1 || bake.sky == 1 ? 0 : environment.panelCount;
    for (int i = 0; i < panelCount; i++) {
        float facing = dot(direction, environment.panels[i].direction.xyz);
        if (facing <= 0.0) {
            continue;
        }

        // Softboxes fall off slightly towards their edges.
        vec3 onPlane = direction / facing;
        vec2 extent = vec2(environment.panels[i].right.w, environment.panels[i].up.w);
        vec2 position = abs(vec2(
            dot(onPlane, environment.panels[i].right.xyz),
            dot(onPlane, environment.panels[i].up.xyz))) / extent;
        vec2 edge = 1.0 - smoothstep(vec2(0.9), vec2(1.0), position);
        color = mix(color, environment.panels[i].radiance.rgb, edge.x * edge.y);
    }

    return color;
}

vec3 cubeDirection(uint face, vec2 uv) {
    switch (face) {
        case 0: return vec3(1.0, -uv.y, -uv.x);
        case 1: return vec3(-1.0, -uv.y, uv.x);
        case 2: return vec3(uv.x, 1.0, uv.y);
        case 3: return vec3(uv.x, -1.0, -uv.y);
        case 4: return vec3(uv.x, -uv.y, 1.0);
        default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

vec2 hammersley(uint i) {
    uint bits = bitfieldReverse(i);
    return vec2(float(i) / float(SAMPLES), float(bits) * 2.3283064365386963e-10);
}

void main() {
    ivec3 size = imageSize(target);
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(texel.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 n = normalize(cubeDirection(uint(texel.z), uv));

    if (environment.skySun.w > 0.0) {
        clearSky = skyState(environment.skySun.xyz, environment.skySun.w);
    }

    if (bake.irradiance == 0 && bake.roughness == 0.0) {
        imageStore(target, texel, vec4(studio(n), 1.0));
        return;
    }

    vec3 tangent = normalize(cross(abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
    vec3 bitangent = cross(n, tangent);
    float alpha = bake.roughness * bake.roughness;

    vec3 sum = vec3(0.0);
    float totalWeight = 0.0;
    for (uint i = 0; i < SAMPLES; i++) {
        vec2 xi = hammersley(i);
        float phi = 2.0 * PI * xi.x;
        vec3 sampleDirection;
        float weight;

        if (bake.irradiance == 1) {
            float r = sqrt(xi.y);
            vec3 l = vec3(r * cos(phi), r * sin(phi), sqrt(1.0 - xi.y));
            sampleDirection = tangent * l.x + bitangent * l.y + n * l.z;
            weight = 1.0;
        } else {
            float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
            float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
            vec3 h = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
            vec3 halfway = tangent * h.x + bitangent * h.y + n * h.z;
            sampleDirection = reflect(-n, halfway);
            weight = max(dot(n, sampleDirection), 0.0);
        }

        if (weight > 0.0) {
            sum += studio(sampleDirection) * weight;
            totalWeight += weight;
        }
    }

    imageStore(target, texel, vec4(sum / totalWeight, 1.0));
}
