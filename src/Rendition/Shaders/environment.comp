#version 460
#extension GL_GOOGLE_include_directive : require
#include "sky.glsl"
#include "atmosphere.glsl"

// Draws one level of the studio environment straight from its description: the bands, or the
// physical sky from its sky-view table in place of the ceiling and horizon when a turbidity is
// set, the panels and the sun's disc. The rough reflections and the soft light are filtered from these levels by
// environment_filter.comp. See "Environment lighting" in docs/design.md.

layout(local_size_x = 8, local_size_y = 8) in;

struct Panel {
    vec4 direction; // xyz: from the studio's centre to the panel
    vec4 right;     // xyz: unit axis; w: half width
    vec4 up;        // xyz: unit axis; w: half height
    vec4 radiance;  // rgb
};

// Must match GpuEnvironment in Vulkan/EnvironmentUniforms.cs.
layout(std140, set = 0, binding = 0) uniform Environment {
    vec4 ceiling;
    vec4 horizon;
    vec4 floorColor; // rgb; a: how much of it the sun and sky light under the physical sky, 1 at noon
    vec4 skySun;  // xyz: towards the sun; w: turbidity, 0 for the bands
    vec4 sunDisc; // rgb: how bright the sun's disc is; a: the cosine of its angular radius
    int panelCount;
    Panel panels[8];
} environment;

layout(rgba16f, set = 0, binding = 1) uniform writeonly image2DArray target;

// The physical sky round the sun; see atmosphere_skyview.comp.
layout(set = 0, binding = 2) uniform sampler2D skyView;

// Must match DrawConstants in Vulkan/EnvironmentPrefilter.cs.
layout(push_constant) uniform Draw {
    int panels; // 1: show the panels; the light probes' sky leaves them out, since direct lights give their light
    int disc;   // 1: show the sun's disc; only the sharp reflection does, since the direct light gives the rest
} draw;

// The physical sky above the horizon and the floor below it, fading from the sky's own horizon.
// The sun's disc sinks behind the horizon with the sun.
vec3 skyAndFloor(vec3 direction) {
    vec3 sun = normalize(environment.skySun.xyz);
    if (direction.y >= 0.0) {
        vec3 color = physicalSky(skyView, direction, sun);
        if (draw.disc == 1) {
            color += sunDiscRadiance(direction, sun, environment.sunDisc);
        }

        return color;
    }

    vec2 across = direction.xz;
    vec3 level = dot(across, across) > 1e-8 ? normalize(vec3(across.x, 0.0, across.y)) : vec3(1.0, 0.0, 0.0);
    vec3 ground = environment.floorColor.rgb * environment.floorColor.a;
    return mix(physicalSky(skyView, level, sun), ground, sqrt(-direction.y));
}

vec3 studio(vec3 direction) {
    vec3 color;
    if (environment.skySun.w > 0.0) {
        color = skyAndFloor(direction);
    } else {
        color = direction.y >= 0.0
            ? mix(environment.horizon.rgb, environment.ceiling.rgb, sqrt(direction.y))
            : mix(environment.horizon.rgb, environment.floorColor.rgb, sqrt(-direction.y));
    }

    int panelCount = draw.panels == 1 ? environment.panelCount : 0;
    for (int i = 0; i < panelCount; i++) {
        float facing = dot(direction, environment.panels[i].direction.xyz);
        if (facing <= 0.0) {
            continue;
        }

        // Softboxes fall off slightly towards their edges.
        vec3 onPlane = direction / facing;
        vec2 extent = vec2(environment.panels[i].right.w, environment.panels[i].up.w);
        vec2 position = abs(vec2(
            dot(onPlane, environment.panels[i].right.xyz),
            dot(onPlane, environment.panels[i].up.xyz))) / extent;
        vec2 edge = 1.0 - smoothstep(vec2(0.9), vec2(1.0), position);
        color = mix(color, environment.panels[i].radiance.rgb, edge.x * edge.y);
    }

    return color;
}

vec3 cubeDirection(uint face, vec2 uv) {
    switch (face) {
        case 0: return vec3(1.0, -uv.y, -uv.x);
        case 1: return vec3(-1.0, -uv.y, uv.x);
        case 2: return vec3(uv.x, 1.0, uv.y);
        case 3: return vec3(uv.x, -1.0, -uv.y);
        case 4: return vec3(uv.x, -uv.y, 1.0);
        default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

void main() {
    ivec3 size = imageSize(target);
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(texel.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 n = normalize(cubeDirection(uint(texel.z), uv));
    imageStore(target, texel, vec4(studio(n), 1.0));
}
