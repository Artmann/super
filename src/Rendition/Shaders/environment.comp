#version 460
#extension GL_GOOGLE_include_directive : require
#include "sky.glsl"
#include "atmosphere.glsl"
#include "cloud_noise.glsl"
#include "cloud_shell.glsl"
#include "cloud_light.glsl"

// Draws one level of the studio environment straight from its description: the bands, or the
// physical sky from its sky-view table in place of the ceiling and horizon when a turbidity is
// set, or a photographed sky's cube in place of both, the panels, the sun's disc, and over the physical sky
// its clouds, flat as the lower settings draw them. The rough reflections and the soft light are filtered from these
// levels by environment_filter.comp. See "Environment lighting" and "Clouds" in docs/design.md.

layout(local_size_x = 8, local_size_y = 8) in;

struct Panel {
    vec4 direction; // xyz: from the studio's centre to the panel
    vec4 right;     // xyz: unit axis; w: half width
    vec4 up;        // xyz: unit axis; w: half height
    vec4 radiance;  // rgb
};

// Must match GpuEnvironment in Vulkan/EnvironmentUniforms.cs.
layout(std140, set = 0, binding = 0) uniform Environment {
    vec4 ceiling;
    vec4 horizon;
    vec4 floorColor; // rgb; a: how much of it the sun and sky light under the physical sky, 1 at noon
    vec4 skySun;  // xyz: towards the sun; w: turbidity, 0 for the bands
    vec4 sunDisc; // rgb: how bright the sun's disc is; a: the cosine of its angular radius
    vec4 image;   // x: 1 to draw the photographed sky; y, z: the cosine and sine of its rotation; w: its scale
    vec4 cloudShape;    // the clouds: x coverage; y density, 0 for no clouds; z the base's height; w the layer's depth, in metres
    vec4 cloudLight;    // xyz: towards the light on them
    vec4 cloudRadiance; // rgb: that light, in the sky's units; a: the cirrus
    vec4 cloudWeather;  // xy: where the camera stands in the weather, in metres; zw: the same for the cirrus
    vec4 cloudAir;      // rgb: the air's haze over the clouds, per metre
    int panelCount;
    Panel panels[8];
} environment;

layout(rgba16f, set = 0, binding = 1) uniform writeonly image2DArray target;

// The physical sky round the sun; see atmosphere_skyview.comp.
layout(set = 0, binding = 2) uniform sampler2D skyView;

// The photographed sky, cooked without its sun, 256 texels a face with every mip; one black texel while none is set.
layout(set = 0, binding = 3) uniform samplerCube skyImage;
const float SKY_IMAGE_SIZE = 256.0;

// The clouds' weather map from cloud_noise.comp, repeating; one texel of no cloud until the renderer points it there.
layout(set = 0, binding = 4) uniform sampler3D cloudWeather;

// Must match DrawConstants in Vulkan/EnvironmentPrefilter.cs.
layout(push_constant) uniform Draw {
    int panels; // 1: show the panels; the light probes' sky leaves them out, since direct lights give their light
    int disc;   // 1: show the sun's disc; only the sharp reflection does, since the direct light gives the rest
    int clouds; // 1: show the clouds; the background leaves them out, since the lighting pass draws them over it
} draw;

// How far up the layer the captures put their single layer, as cloud_march.comp's FLAT_FRACTION does.
const float CAPTURE_FRACTION = 0.15;

// How far off the captures draw the clouds, in metres, as cloud_march.comp's CLOUD_REACH.
const float CAPTURE_REACH = 80000.0;

// Puts a cloud hiding cover of what lies behind it over color, seen through the air's haze from this far off, which
// turns it towards the sky behind.
vec3 hazed(vec3 color, vec3 lit, float cover, float distance) {
    vec3 kept = exp(-environment.cloudAir.rgb * distance);
    return mix(color, lit * kept + color * (1.0 - kept), cover);
}

// The clouds over the sky as seen from the ground: the cirrus, then a single layer of cumulus in front of it, its heaps
// the weather map's puffs rather than the marched noise, which no capture could afford. Lit as the clouds on screen
// are, so the light they give the scene matches them, and an overcast sky greys it.
vec3 overClouds(vec3 color, vec3 direction, vec3 sun) {
    if (draw.clouds == 0 || environment.cloudShape.y <= 0.0 || direction.y <= 0.0) {
        return color;
    }

    vec3 zenith = physicalSky(skyView, vec3(0.0, 1.0, 0.0), sun);
    vec3 level = normalize(vec3(direction.x, 0.0, direction.z) + vec3(1e-4, 0.0, 0.0));
    vec3 horizon = physicalSky(skyView, normalize(level + vec3(0.0, 0.05, 0.0)), sun);
    vec3 l = environment.cloudLight.xyz;
    float cosine = dot(direction, l);
    vec3 radiance = environment.cloudRadiance.rgb;

    float high = cloudShellHits(0.0, CIRRUS_ALTITUDE, direction).y;
    if (environment.cloudRadiance.a > 0.0 && high > 0.0) {
        vec2 at = direction.xz * high + environment.cloudWeather.zw;
        float streaks = textureLod(cloudWeather, vec3(at / (CLOUD_WEATHER_PERIOD * 0.25), 0.5), 0.0).b;
        float cover = cloudCirrusCover(streaks, environment.cloudRadiance.a, high);
        color = hazed(color, cloudCirrusLight(radiance, cosine, zenith), cover, high);
    }

    float middle = environment.cloudShape.z + environment.cloudShape.w * CAPTURE_FRACTION;
    float t = cloudShellHits(0.0, middle, direction).y;
    if (t <= 0.0 || t > CAPTURE_REACH) {
        return color;
    }

    vec4 weather = textureLod(cloudWeather, vec3((direction.xz * t + environment.cloudWeather.xy) / CLOUD_WEATHER_PERIOD, 0.5), 0.0);
    float coverage = cloudCoverage(environment.cloudShape.x, weather);
    float puffs = clamp((weather.a - 0.45) / 0.4, 0.0, 1.0);
    float cloud = clamp((puffs - (1.0 - coverage)) / max(coverage, 1e-3), 0.0, 1.0);
    if (cloud <= 0.0) {
        return color;
    }

    // Optical depth through the whole layer, a quarter of it in view as the lower settings' layer has.
    float depth = cloud * environment.cloudShape.y * CLOUD_EXTINCTION * environment.cloudShape.w;
    float cover = 1.0 - exp(-depth * 0.25 / max(direction.y, 0.2));
    float towardsLight = depth * (1.0 - CAPTURE_FRACTION) * 0.35 / max(l.y, 0.15);
    vec3 lit = radiance * cloudScattering(towardsLight, cosine) + cloudSkyAround(CAPTURE_FRACTION, zenith, horizon);
    return hazed(color, lit, cover, t);
}

// The physical sky above the horizon and the floor below it, fading from the sky's own horizon.
// The sun's disc sinks behind the horizon with the sun, and hides behind the clouds.
vec3 skyAndFloor(vec3 direction) {
    vec3 sun = normalize(environment.skySun.xyz);
    if (direction.y >= 0.0) {
        vec3 color = physicalSky(skyView, direction, sun);
        if (draw.disc == 1) {
            color += sunDiscRadiance(direction, sun, environment.sunDisc);
        }

        return overClouds(color, direction, sun);
    }

    vec2 across = direction.xz;
    vec3 level = dot(across, across) > 1e-8 ? normalize(vec3(across.x, 0.0, across.y)) : vec3(1.0, 0.0, 0.0);
    vec3 ground = environment.floorColor.rgb * environment.floorColor.a;
    return mix(physicalSky(skyView, level, sun), ground, sqrt(-direction.y));
}

// The photographed sky, turned about the up axis, read at the mip whose texels are about as wide as the target's, and
// its sun's disc where it was photographed.
vec3 photographed(vec3 direction, float targetSize) {
    float c = environment.image.y, s = environment.image.z;
    vec3 turned = vec3(direction.x * c - direction.z * s, direction.y, direction.x * s + direction.z * c);
    float lod = max(log2(SKY_IMAGE_SIZE / targetSize), 0.0);
    vec3 color = textureLod(skyImage, turned, lod).rgb * environment.image.w;
    if (draw.disc == 1) {
        color += sunDiscRadiance(direction, environment.skySun.xyz, environment.sunDisc);
    }

    return color;
}

vec3 studio(vec3 direction, float targetSize) {
    vec3 color;
    if (environment.image.x > 0.5) {
        color = photographed(direction, targetSize);
    } else if (environment.skySun.w > 0.0) {
        color = skyAndFloor(direction);
    } else {
        color = direction.y >= 0.0
            ? mix(environment.horizon.rgb, environment.ceiling.rgb, sqrt(direction.y))
            : mix(environment.horizon.rgb, environment.floorColor.rgb, sqrt(-direction.y));
    }

    int panelCount = draw.panels == 1 ? environment.panelCount : 0;
    for (int i = 0; i < panelCount; i++) {
        float facing = dot(direction, environment.panels[i].direction.xyz);
        if (facing <= 0.0) {
            continue;
        }

        // Softboxes fall off slightly towards their edges.
        vec3 onPlane = direction / facing;
        vec2 extent = vec2(environment.panels[i].right.w, environment.panels[i].up.w);
        vec2 position = abs(vec2(
            dot(onPlane, environment.panels[i].right.xyz),
            dot(onPlane, environment.panels[i].up.xyz))) / extent;
        vec2 edge = 1.0 - smoothstep(vec2(0.9), vec2(1.0), position);
        color = mix(color, environment.panels[i].radiance.rgb, edge.x * edge.y);
    }

    return color;
}

vec3 cubeDirection(uint face, vec2 uv) {
    switch (face) {
        case 0: return vec3(1.0, -uv.y, -uv.x);
        case 1: return vec3(-1.0, -uv.y, uv.x);
        case 2: return vec3(uv.x, 1.0, uv.y);
        case 3: return vec3(uv.x, -1.0, -uv.y);
        case 4: return vec3(uv.x, -uv.y, 1.0);
        default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

void main() {
    ivec3 size = imageSize(target);
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(texel.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 n = normalize(cubeDirection(uint(texel.z), uv));
    imageStore(target, texel, vec4(studio(n, float(size.x)), 1.0));
}
